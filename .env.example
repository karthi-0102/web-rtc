# --- AWS ---------------------------------------------------------------
AWS_REGION=us-east-1
# Credentials come from the standard chain (env vars, ~/.aws/credentials,
# SSO, EC2/ECS role). Set AWS_PROFILE to pick a named profile.
#AWS_PROFILE=default

# Signaling channel (create it once: see README)
KVS_CHANNEL_NAME=hubFirmware-test

# Set to true when host/srflx candidates never pair (symmetric NAT, CGNAT).
#KVS_FORCE_TURN=false

# --- Outbound media ----------------------------------------------------
# test | screen | /dev/video0 | /path/to/clip.mp4 | rtsp://...
VIDEO_INPUT=test
VIDEO_WIDTH=640
VIDEO_HEIGHT=480
VIDEO_FPS=30

# test | alsa:default | pulse:default | /path/to/audio.wav
AUDIO_INPUT=test
AUDIO_SAMPLE_RATE=48000
AUDIO_CHANNELS=1
#AUDIO_MAX_BUFFER_MS=400

# --- Inbound media -----------------------------------------------------
# play (ffplay) | file (record to OUT_DIR) | none
AUDIO_OUT=play
VIDEO_OUT=play
OUT_DIR=./recordings

# Live playback latency budget (GStreamer receiver, ingest path).
# JITTER_LATENCY_MS  webrtcbin jitter buffer depth. Lower = closer to live,
#                    below ~50 reordering starts costing frames.
# PLAYOUT_QUEUE_MS   ceiling on decoded backlog per sink branch. This is how
#                    far behind live playback may fall after a network stall
#                    before old buffers get dropped to catch up.
JITTER_LATENCY_MS=100
PLAYOUT_QUEUE_MS=200

# Inbound talk-back audio on the ingest master.
# TALKBACK_SINK_MS   sink ring buffer. The floor on how late talk-back is
#                    heard; the pulsesink default of 200 is the single biggest
#                    local term. Lower is tighter, too low risks crackle.
# TALKBACK_QUEUE_MS  decoded backlog kept before the oldest buffer is dropped.
TALKBACK_SINK_MS=40
TALKBACK_QUEUE_MS=60

# Pin remote audio to one speaker (PulseAudio/PipeWire sink node.name).
# Unset = system default sink. List sinks with `wpctl status`, get the name
# with `wpctl inspect <id> | grep node.name`.
#AUDIO_OUT_DEVICE=alsa_output.pci-0000_00_1f.3-...__sink

# --- Monitor window ----------------------------------------------------
# Local web dashboard for a running master: a live thumbnail of the video being
# published, every signaling message (SDP/ICE) in and out, per-peer state and
# RTP bitrates, and the log stream. Read-only; bound to localhost.
#MONITOR=false                 # switch it off entirely
MONITOR_PORT=8088
#MONITOR_HOST=127.0.0.1        # 0.0.0.0 exposes your live video on the LAN
#MONITOR_PREVIEW_FPS=4         # thumbnail rate, not the published rate

# --- Logging -----------------------------------------------------------
# error | warn | info | debug | trace
#   info  : lifecycle steps, SDP summaries, per-5s RTP stats
#   debug : + every ICE candidate, ffmpeg command lines and stderr, frame rates
#   trace : + full SDP bodies
LOG_LEVEL=debug

# Shortcut for LOG_LEVEL=debug (also kept for ffmpeg stderr)
#DEBUG_MEDIA=true

# Drop the timestamp column / disable ANSI colors
#LOG_TIMESTAMPS=false
#NO_COLOR=1

# How often to print tx/rx bitrate, fps, packet loss and the ICE pair
#STATS_INTERVAL_MS=5000

# Override the viewer's client id (alphanumeric, _ . - only)
#KVS_CLIENT_ID=operator-1
