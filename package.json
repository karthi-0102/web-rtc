  "description": "Amazon Kinesis Video Streams WebRTC two-way media: master streams video+audio and receives audio; viewer receives video+audio and sends audio back.",
  "private": true,
  "main": "src/master.js",
  "scripts": {
    "master": "node src/master.js",
